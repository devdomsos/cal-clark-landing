# Cal Clark API that stores waitlist signups and sends the confirm email.
# Local: the API from `npm run dev` in the app repo.
# Production (Vercel): https://api.calclark.app  (server-only, not NEXT_PUBLIC)
CAL_CLARK_API_URL=http://127.0.0.1:3847

# Optional trackers. Each loads only when its key is set AND the visitor
# allowed the partner in the cookie banner (src/lib/cookieConsent.ts).
# Google Analytics 4 measurement id (partner "google_ads").
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# AppsFlyer OneLink Smart Script (partner "appsflyer"): rewrites store links
# marked data-store-link with the campaign params of the landing URL.
# Subdomain + template id come from AppsFlyer -> OneLink.
NEXT_PUBLIC_APPSFLYER_ONELINK_SUBDOMAIN=""
NEXT_PUBLIC_APPSFLYER_ONELINK_TEMPLATE_ID=""
